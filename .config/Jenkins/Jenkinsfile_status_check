pipeline {
    agent any
    options {
        buildDiscarder(logRotator(numToKeepStr: "3"))
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_IMAGE_NAME = "my-app" 
        DOCKER_IMAGE_TAG = "latest" 
    }

    stages {
        stage('SonarQube Code Analysis') {
            when {
                anyOf {
                    branch 'main'
                    changeRequest(target: 'main')
                }
            }
            steps {
                script {
                    def scannerHome = tool name: 'sonar-scanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    withSonarQubeEnv('sonarqube') {
                        sh "${scannerHome}/bin/sonar-scanner"
                    }
                }
            }
        }

        stage('Check SonarQube Quality Gate') {
            when {
                anyOf {
                    branch 'main'
                    changeRequest(target: 'main')
                }
            }
            steps {
                script {
                    def qualityGateStatus = waitForQualityGate()
                    if (qualityGateStatus.status != 'OK') {
                        error "Quality Gate failed! Status: ${qualityGateStatus.status}"
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG} ."
                }
            }
        }

        stage('Deploy Stage for Main') {
             when {
                anyOf {
                    branch 'main'
                    changeRequest(target: 'main')
                }
            }
            steps {
                script {
                    echo "Successfully deployed to main"
                    
                }
            }
        }

        stage('Deploy Stage for UAT') {
              when {
                branch 'UAT'
            }
            steps {
                script {
                    echo "Successfully deployed to UAT"
                  
                }
            }
        }
    }

    post {
        success {
            script {
                echo "SUCCESS: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' completed successfully."
            }
        }
        failure {
            script {
                echo "FAILURE: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' failed."
            }
        }
    }
}
